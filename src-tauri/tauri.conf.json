{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PD-EZ",
  "version": "0.1.0",
  "identifier": "ai.zugabot.pdez",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3011",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PD-EZ",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pdfium/bin/pdfium.dll": "pdfium/bin/pdfium.dll",
      "qpdf/bin/": "qpdf/bin/",
      "tesseract/": "tesseract/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
