{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZugaPDF",
  "version": "0.1.0",
  "identifier": "ai.zugabot.zugapdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3011",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZugaPDF",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pdfium/bin/pdfium.dll": "pdfium/bin/pdfium.dll",
      "qpdf/bin/": "qpdf/bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
